  <ItemGroup Label="CAPTCHA font">
    <!--
      Embedded, not loaded from the OS: the aspnet container image ships without fonts, so a
      SystemFonts lookup would work on a dev machine and fail in production.
      Roboto Mono, SIL Open Font License 1.1 — see Captcha/Fonts/OFL.txt.
    -->
    <EmbeddedResource Include="Captcha\Fonts\RobotoMono.ttf" />
    <None Include="Captcha\Fonts\OFL.txt" Pack="true" />
  </ItemGroup>

