{
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=ThreadlineComments;User Id=sa;Password=Your_strong_Passw0rd;TrustServerCertificate=True;Encrypt=False;Max Pool Size=200",
    "Redis": "localhost:6379",
    "RabbitMq": "amqp://guest:guest@localhost:5672/"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "Alias": "comments",
    "IndexName": "comments-v1",
    "NumberOfShards": 1,
    "NumberOfReplicas": 0,
    "RequestTimeout": "00:00:10"
  },
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "attachments"
  },
  "Privacy": {
    "IpHashPepper": ""
  },
  "Outbox": {
    "BatchSize": 200,
    "PollInterval": "00:00:00.500",
    "MaxAttempts": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:8080" ]
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "MassTransit": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
