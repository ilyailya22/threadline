{
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=ThreadlineComments;User Id=sa;Password=Your_strong_Passw0rd;TrustServerCertificate=True;Encrypt=False;Max Pool Size=100",
    "Redis": "localhost:6379",
    "RabbitMq": "amqp://guest:guest@localhost:5672/"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "Alias": "comments",
    "IndexName": "comments-v1",
    "NumberOfShards": 1,
    "NumberOfReplicas": 0,
    "RequestTimeout": "00:00:10"
  },
  "Storage": {
    "//": "No ConnectionString here: it would win over the AccountUrl that Azure sets, and every upload would go to a local emulator that is not there. The development value lives in appsettings.Development.json; Docker Compose passes its own.",
    "ContainerName": "attachments"
  },
  "Privacy": {
    "IpHashPepper": ""
  },
  "Outbox": {
    "BatchSize": 200,
    "PollInterval": "00:00:00.500",
    "MaxAttempts": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "MassTransit": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
