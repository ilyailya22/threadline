# Optional overrides for docker-compose.yml. Copy to .env and edit.
# Every value has a working default, so this file is not required to run the stack.

# ---- credentials (local stack only — never reuse these anywhere real)
MSSQL_SA_PASSWORD=Your_strong_Passw0rd
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
IP_HASH_PEPPER=change-me-in-production-please

# ---- host ports
WEB_PORT=8080
API_PORT=5080
SQL_PORT=1433
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
ELASTIC_PORT=9200
AZURITE_PORT=10000

# ---- rate limits per client per minute (production defaults shown).
# Raise for load tests: a single load generator is one client.
RATE_LIMIT_READ=300
RATE_LIMIT_WRITE=10
RATE_LIMIT_CAPTCHA=30

# ---- environment
ASPNETCORE_ENVIRONMENT=Production
