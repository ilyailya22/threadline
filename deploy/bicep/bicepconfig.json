{
  // Linter configuration for the deployment templates.
  "analyzers": {
    "core": {
      "enabled": true,
      "verbose": false,
      "rules": {
        // Every connection string in workloads.bicep is assembled from parameters that ARE marked
        // @secure(), but Bicep does not propagate that marking through string interpolation, so the
        // rule fires on values that are in fact handled correctly: they go straight into a Container
        // Apps secret, which Azure stores encrypted and never returns in a template read.
        //
        // The rule is kept on as information rather than switched off, so a genuinely insecure value
        // is still visible in the output — it just does not drown the build in warnings that have
        // already been reviewed.
        "use-secure-value-for-secure-inputs": {
          "level": "info"
        }
      }
    }
  }
}
