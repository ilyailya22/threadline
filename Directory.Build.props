<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Every assembly is prefixed with a vendor segment. Without it, a feature folder named
      "Comments" inside a project named "Comments.*" produces a nested namespace that shadows the
      root one, and `using Comments.Application...` silently resolves to the wrong thing.
    -->
    <RootNamespace>Threadline.$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>Threadline.$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Metadata">
    <Company>Illya Merikhov</Company>
    <Product>Threadline Comments</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
